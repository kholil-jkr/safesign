// SafeSign — Contract Management Platform schema
// Module 1 "Analyzer" stays stateless; Module 2 "Manajemen" persists contracts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String? // null → akun OAuth (Google) tanpa password
  provider     String        @default("credentials") // credentials | google
  image        String? // avatar (URL)
  role         String        @default("user") // admin | legal | manager | staff | user
  failedLogins Int           @default(0) // counter brute-force (lintas instance, tersimpan di DB)
  lockedUntil  DateTime? // null / sudah lewat = tidak terkunci
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contracts    Contract[]    @relation("CreatedContracts")
  analysisLogs AnalysisLog[]
  advocacyCases AdvocacyCase[]
}

// ─── Riwayat Kontrak (Analyzer) ────────────────────────────────────────────────
// Seperti "log chat" pada chatbot AI: satu user bisa punya banyak hasil analisis
// kontrak, membuka ulang, dan menghapusnya. Analisis saat Mode Penyamaran aktif
// ditandai incognito=true dan DIHAPUS permanen saat user logout.
model AnalysisLog {
  id          String   @id @default(cuid())
  userId      String
  title       String // judul kontrak / nama file / cuplikan teks
  language    String   @default("en") // bahasa analisis (en/id/...)
  sourceType  String? // camera | photo | file | cloud | template | sample | manual
  inputText   String? // teks kontrak asli (dipangkas)
  resultJson  String // hasil analisis AI (AnalysisResult JSON)
  riskLevel   String? // low | medium | high
  incognito   Boolean  @default(false) // true = hapus permanen saat logout
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contract {
  id            String   @id @default(cuid())
  title         String
  contractNo    String?
  partyA        String? // pihak pertama (perusahaan/kami)
  partyB        String? // pihak kedua (counterparty)
  startDate     DateTime?
  endDate       DateTime?
  value         Float?
  currency      String   @default("IDR")
  category      String   @default("other") // employment | vendor | lease | nda | service | other
  tags          String   @default("") // comma separated
  status        String   @default("draft") // draft | pending_approval | approved | rejected | terminated
  riskLevel     String? // low | medium | high
  analysisJson  String? // AnalysisResult JSON (Analyzer structure)
  contentText   String? // full contract text
  sourceType    String? // camera | photo | file | cloud | template | manual
  fileName      String?
  autoRenew     Boolean  @default(false)
  notes         String?
  remindersJson String   @default("[90,60,30,7]") // enabled day thresholds
  ackedJson     String   @default("[]") // acknowledged reminder keys "contractId:days"
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User?    @relation("CreatedContracts", fields: [createdById], references: [id])
  versions      ContractVersion[]
  approvals     Approval[]
  signatures    Signature[]
}

model ContractVersion {
  id          String   @id @default(cuid())
  contractId  String
  version     Int
  title       String
  contentText String?
  snapshotJson String? // key fields snapshot at save time
  changeNote  String?
  editedBy    String?
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Approval {
  id           String    @id @default(cuid())
  contractId   String
  step         Int       @default(1)
  approverRole String // manager | legal
  approverName String?
  status       String    @default("pending") // pending | approved | rejected
  note         String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Signature {
  id            String   @id @default(cuid())
  contractId    String
  signerName    String
  signerRole    String   @default("party_b") // party_a | party_b | witness
  signatureData String // data:image/png;base64,...
  typedName     String?
  signedAt      DateTime @default(now())
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Template {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("other")
  description String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Modul Advokasi ─────────────────────────────────────────────────────────
// AI-assisted institutional outreach: smart institution matching, AI-drafted
// advocacy emails (with user permission gate), case tracking & follow-ups.

model Institution {
  id                 String   @id @default(cuid())
  name               String
  shortName          String?
  type               String // government | embassy | international | ngo
  originCountry      String   @default("ANY") // negara asal yang dilayani; "ANY" = semua
  destinationCountry String? // negara penempatan; null = semua negara
  categories         String   @default("") // comma separated: SALARY,ABUSE,TRAFFICKING,CONTRACT,REPATRIATION,PLACEMENT,DOCUMENT,WELFARE
  email              String?
  phone              String?
  website            String?
  address            String?
  description        String   @default("")
  jurisdiction       String   @default("") // lingkup kewenangan
  priority           Int      @default(50) // 1 = paling prioritas
  responseTime       String?
  language           String   @default("English")
  cases              AdvocacyCase[]
  createdAt          DateTime @default(now())
}

model AdvocacyCase {
  id                 String       @id @default(cuid())
  caseNumber         String       @unique
  userId             String? // pemilik kasus (user login); null = warisan data lama
  title              String
  category           String // SALARY | ABUSE | TRAFFICKING | CONTRACT | REPATRIATION | PLACEMENT | DOCUMENT | WELFARE
  priority           String       @default("medium") // low | medium | high | urgent
  status             String       @default("draft") // draft | sent | followed_up | in_progress | resolved | closed
  originCountry      String       @default("Indonesia")
  destinationCountry String?
  chronology         String?
  anonymous          Boolean      @default(false)
  contractId         String? // plain ref (no FK) — kontrak terkait di registry
  institutionId      String
  timelineJson       String       @default("[]") // [{at, event, note?, by?}]
  attachmentsJson    String       @default("[]") // [{name, kind}]
  createdByEmail     String       @default("")
  createdByName      String       @default("")
  sentAt             DateTime?
  followUpDue        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  institution        Institution  @relation(fields: [institutionId], references: [id])
  user               User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails             CaseEmail[]
}

model CaseEmail {
  id               String       @id @default(cuid())
  caseId           String
  type             String       @default("initial") // initial | followup
  subject          String
  body             String // bahasa lembaga (default English)
  bodyUser         String? // terjemahan ke bahasa user
  advice           String?
  attachmentsJson  String       @default("[]")
  status           String       @default("draft") // draft | sent | replied
  sentAt           DateTime?
  repliedAt        DateTime? // waktu balasan lembaga diterima (webhook inbound)
  replyFrom        String? // pengirim balasan
  replyText        String? // isi balasan (dari webhook inbound email)
  messageId        String? // SMTP Message-ID (untuk mencocokkan balasan)
  createdAt        DateTime     @default(now())
  case             AdvocacyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}
