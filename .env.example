# SafeSign environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is gitignored by design.

# Cloudflare Workers AI (used server-side only; get a token at
# https://dash.cloudflare.com → My Profile → API Tokens → Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model configuration (defaults shown; override only if needed)
SAFESIGN_PRIMARY_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
SAFESIGN_FALLBACK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
SAFESIGN_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Database — Prisma connection string.
# Local dev: file:/absolute/path/to/db/custom.db (SQLite)
# Production (Vercel): hosted Postgres/Neon connection string, e.g.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional: SMTP for the Advokasi module's autonomous email sending.
# If unset, the app falls back to "manual mode" (mailto link + copyable draft).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
